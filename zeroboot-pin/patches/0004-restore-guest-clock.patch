+    let chunks = find_msr_chunks(data);
+    if chunks.iter().map(|&(_, n)| n).sum::<usize>() >= 8 {
+        // Chunks are in file order, so IA32_TSC (main chunk) precedes
+        // TSC_DEADLINE (its own later chunk), as KVM requires.
+        for (start, n) in chunks {
