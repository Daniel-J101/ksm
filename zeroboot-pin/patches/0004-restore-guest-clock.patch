+/// Locate Firecracker's serialized MSR chunks (ksm patch 0004). Each chunk is
+///   u64 8, u64 n, u64 n,  then n x { u64 16, u32 index, u32 0, u64 data }
+/// (versionize Vec<kvm_msr_entry>). Firecracker splits the list: the main chunk
+/// (~190 MSRs) and a 1-entry chunk holding TSC_DEADLINE, which must be restored
+/// after IA32_TSC. Returns every (records_start, n) whose header AND all n
+/// records match -- a far stricter anchor than scanning for index values.
+fn find_msr_chunks(data: &[u8]) -> Vec<(usize, usize)> {
+    let rec = |o: usize| o + 24 <= data.len() && r64(data, o) == 16 && r32(data, o + 12) == 0;
+    let mut out = Vec::new();
+    let mut o = 0;
+    while o + 24 <= data.len() {
+        let n = r64(data, o + 8) as usize;
+        if r64(data, o) == 8 && n >= 1 && n <= 1024 && r64(data, o + 16) == n as u64
+            && (0..n).all(|k| rec(o + 24 + 24 * k)) {
+            out.push((o + 24, n));
+            o += 24 + 24 * n;
+        } else {
+            o += 1;
+        }
+    }
+    out
+}
