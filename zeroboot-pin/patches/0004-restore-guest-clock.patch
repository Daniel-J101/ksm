+/// Guest kvmclock time (ns) at snapshot: the guest's pvclock record (GPA from
+/// MSR_KVM_SYSTEM_TIME_NEW) extrapolated to the snapshot TSC (MSR IA32_TSC).
+/// None if either is missing -- then behaviour is unchanged from upstream.
+fn snapshot_guest_ns(snapshot: &VmSnapshot, mem: *const u8) -> Option<u64> {
+    let msr = |i: u32| snapshot.msrs.iter().find(|e| e.index == i).map(|e| e.data);
+    let st = msr(0x4b564d01)?;
+    let tsc = msr(0x10)?;
+    if st & 1 == 0 { return None; }
+    let gpa = (st & !1) as usize;
+    if gpa + 32 > snapshot.mem_size { return None; }
+    // struct pvclock_vcpu_time_info { u32 version, pad; u64 tsc_timestamp;
+    //   u64 system_time; u32 tsc_to_system_mul; i8 tsc_shift; u8 flags; }
+    let (tsc_ts, sys, mul, shift) = unsafe {
+        let p = mem.add(gpa);
+        (ptr::read_unaligned(p.add(8) as *const u64),
+         ptr::read_unaligned(p.add(16) as *const u64),
+         ptr::read_unaligned(p.add(24) as *const u32),
+         ptr::read_unaligned(p.add(28) as *const i8))
+    };
+    let delta = tsc.checked_sub(tsc_ts)?;
+    let delta = if shift >= 0 { delta << shift } else { delta >> (-shift) };
+    Some(sys + ((delta as u128 * mul as u128) >> 32) as u64)
+}
