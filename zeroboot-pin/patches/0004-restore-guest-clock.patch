         (0xc0000081, |v| v != 0),
@@ -399,22 +422,42 @@ fn parse_msrs(data: &[u8]) -> Vec<kvm_msr_entry> {
         (0xc0000102, |_| true),
         (0x4b564d00, |v| v != 0 && v < 0x100000000),
         (0x4b564d01, |v| v != 0 && v < 0x100000000),
+        // ksm patch 0004: guest TSC + TSC-deadline timer. Without these every
+        // fork's TSC restarts at 0 while the guest's timers were armed against
+        // the snapshot-time TSC, so the first sleep in a fork stalls for
+        // (boot -> snapshot) seconds. Only taken from the real MSR array:
+        // index 0x10 also matches length prefixes all over the vmstate.
+        (0x10, |v| v > 0),
