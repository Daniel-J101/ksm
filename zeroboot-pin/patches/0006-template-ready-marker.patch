+/// Guest console watcher (ksm patch 0006): Firecracker's stdout is the guest
+/// serial console. Tee it to <workdir>/console.log and record whether the
+/// ready marker has appeared.
+struct Console {
+    seen: std::sync::Arc<(std::sync::Mutex<bool>, std::sync::Condvar)>,
+    log_path: String,
+}
+
+impl Console {
+    fn spawn(mut out: std::process::ChildStdout, log_path: String, marker: Option<String>) -> Self {
+        let seen = std::sync::Arc::new((std::sync::Mutex::new(false), std::sync::Condvar::new()));
+        let seen2 = seen.clone();
+        let path = log_path.clone();
+        std::thread::spawn(move || {
+            let mut log = std::fs::File::create(&path).ok();
+            let mut tail: Vec<u8> = Vec::new();
+            let mut buf = [0u8; 8192];
+            while let Ok(n) = out.read(&mut buf) {
+                if n == 0 { break; }
+                if let Some(f) = log.as_mut() { let _ = f.write_all(&buf[..n]); }
+                if let Some(m) = &marker {
+                    tail.extend_from_slice(&buf[..n]);
+                    if tail.windows(m.len()).any(|w| w == m.as_bytes()) {
+                        let (lock, cv) = &*seen2;
+                        *lock.lock().unwrap() = true;
+                        cv.notify_all();
+                        tail.clear();
+                    } else if tail.len() > m.len() {
+                        tail.drain(..tail.len() - m.len());
+                    }
+                }
+            }
+        });
+        Console { seen, log_path }
+    }
+
+    /// Wait up to `dur` for the marker. Returns whether it was seen.
+    fn wait(&self, dur: Duration) -> bool {
+        let (lock, cv) = &*self.seen;
+        let guard = lock.lock().unwrap();
+        let (guard, _) = cv.wait_timeout_while(guard, dur, |seen| !*seen).unwrap();
+        *guard
+    }
+}
 
