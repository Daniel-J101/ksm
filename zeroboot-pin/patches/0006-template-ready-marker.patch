+/// Firecracker API timeout (ksm patch 0006: ZEROBOOT_FC_TIMEOUT_SECS, default
+/// 120). A Full snapshot writes the mem file at ~80 MB/s, so multi-GB templates
+/// need more than the default.
+fn fc_socket_timeout() -> Duration {
+    let secs = std::env::var("ZEROBOOT_FC_TIMEOUT_SECS").ok()
+        .and_then(|v| v.parse().ok()).unwrap_or(120);
+    Duration::from_secs(secs)
+}
