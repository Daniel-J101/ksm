+/// ZEROBOOT_KSM_MERGEABLE=1 -> madvise(MADV_MERGEABLE) every fork mapping (read once).
+fn ksm_mergeable() -> bool {
+    static FLAG: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *FLAG.get_or_init(|| {
+        let on = std::env::var("ZEROBOOT_KSM_MERGEABLE").map(|v| v == "1").unwrap_or(false);
+        if on { eprintln!("KSM: fork mappings will be madvise(MADV_MERGEABLE)"); }
+        on
+    })
+}
