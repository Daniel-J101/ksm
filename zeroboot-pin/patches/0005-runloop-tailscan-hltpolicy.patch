     pub fn run_until_marker_timeout(&mut self, marker: &str, max_exits: u64, timeout: Option<Duration>) -> Result<String> {
+        // ksm patch 0005: scan only the newly written tail for the marker
+        // (upstream re-scanned the whole output on every byte: O(n^2)).
+        let m = marker.as_bytes();
+        let mut scanned = 0usize;
+        self.run_until(max_exits, timeout, HltPolicy::EndRun, |out| {
+            let from = scanned.saturating_sub(m.len().saturating_sub(1));
+            scanned = out.len();
+            out[from..].windows(m.len()).any(|w| w == m)
+        })?;
+        Ok(String::from_utf8_lossy(&self.serial.output).to_string())
+    }
