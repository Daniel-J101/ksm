 extern "C" fn noop_signal_handler(_: libc::c_int) {}
 
+/// What an HLT exit with no pending serial input means (ksm patch 0005).
+#[derive(Clone, Copy)]
+pub enum HltPolicy {
+    /// Upstream behaviour: the guest is done; end the run.
+    EndRun,
+    /// Persistent sandboxes: the guest is just idle; keep running.
+    Continue,
+}
+
+/// One-shot SIGALRM to the calling thread after `dur`, cancelled on drop.
+struct TimerGuard(Option<std::sync::mpsc::Sender<()>>);
+
+impl TimerGuard {
+    fn arm(dur: Duration) -> Self {
+        unsafe {
+            let mut sa: libc::sigaction = std::mem::zeroed();
+            sa.sa_sigaction = noop_signal_handler as *const () as usize;
+            sa.sa_flags = 0; // no SA_RESTART, so KVM_RUN returns EINTR
+            libc::sigaction(libc::SIGALRM, &sa, std::ptr::null_mut());
+        }
+        let target = unsafe { libc::pthread_self() };
+        let (tx, rx) = std::sync::mpsc::channel::<()>();
+        std::thread::spawn(move || {
+            if let Err(std::sync::mpsc::RecvTimeoutError::Timeout) = rx.recv_timeout(dur) {
+                unsafe { libc::pthread_kill(target, libc::SIGALRM); }
+            }
+        });
+        TimerGuard(Some(tx))
+    }
+}
+
+impl Drop for TimerGuard {
+    fn drop(&mut self) {
+        // Wake the helper so it exits without signalling. (A run that ended by
+        // timeout has already been signalled; a late EINTR is handled.)
+        if let Some(tx) = self.0.take() { let _ = tx.send(()); }
+    }
+}
