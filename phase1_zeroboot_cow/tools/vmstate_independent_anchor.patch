+            continue; // CR0.PE and CR0.PG must be set (paging on)
+        }
+        if cr3 == 0 || cr3 & 0xFFF != 0 {
+            continue; // CR3 is a nonzero, 4K-aligned physical address
+        }
+        matches += 1;
+        if first.is_none() {
+            first = Some(e);
+        }
+    }
+    match first {
+        Some(e) => {
