+/// Locate EFER (and thereby the whole vCPU block) by content, independent of
+/// where IOAPIC landed. EFER is a small long-mode constant; the APIC-base MSR
+/// immediately after it masks to 0xFEE00000. We additionally require a plausible
+/// CR0 (PE|PG) and CR3 (nonzero, page-aligned) just before, which disambiguates
+/// the real EFER from an identical value sitting in the MSR list.
+fn find_efer(data: &[u8]) -> Result<usize> {
+    const CR_DELTA: isize = REF_CR as isize - REF_EFER as isize; // -0x28
+    let mut first: Option<usize> = None;
+    let mut matches = 0usize;
+    for e in 0..data.len().saturating_sub(16) {
+        let efer = r64(data, e);
+        if efer != 0xD01 && efer != 0x501 {
+            continue;
+        }
+        if r64(data, e + 8) & 0xFFFF_F000 != 0xFEE0_0000 {
+            continue; // APIC base MSR right after EFER
+        }
+        let cr = e as isize + CR_DELTA;
